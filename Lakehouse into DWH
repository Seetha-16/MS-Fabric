CREATE OR ALTER PROCEDURE P1_LH
    (@OrderYear INT)
AS
BEGIN

    -- Step 1: Load Customer dimension
    INSERT INTO Sales.Dim_Customer
        (CustomerID, CustomerName, FirstName, LastName, EmailAddress)
    SELECT DISTINCT
        s.CustomerName,
        s.CustomerName,
        LEFT(s.CustomerName, CHARINDEX(' ', s.CustomerName + ' ') - 1),
        LTRIM(SUBSTRING(s.CustomerName, CHARINDEX(' ', s.CustomerName + ' ') + 1, LEN(s.CustomerName))),
        s.EmailAddress
    FROM salesdata s
    WHERE YEAR(s.OrderDate) = @OrderYear
      AND s.CustomerName IS NOT NULL
      AND LTRIM(RTRIM(s.CustomerName)) <> ''
      AND s.Item IS NOT NULL
      AND s.SalesOrderNumber IS NOT NULL
      AND NOT EXISTS (
            SELECT 1
            FROM Sales.Dim_Customer c
            WHERE c.CustomerName = s.CustomerName
              AND ISNULL(c.EmailAddress, '') = ISNULL(s.EmailAddress, '')
      );

    -- Step 2: Load Item dimension
    INSERT INTO Sales.Dim_Item
        (ItemID, ItemName)
    SELECT DISTINCT
        s.Item,
        s.Item
    FROM salesdata s
    WHERE YEAR(s.OrderDate) = @OrderYear
      AND s.CustomerName IS NOT NULL
      AND LTRIM(RTRIM(s.CustomerName)) <> ''
      AND s.Item IS NOT NULL
      AND s.SalesOrderNumber IS NOT NULL
      AND NOT EXISTS (
            SELECT 1
            FROM Sales.Dim_Item i
            WHERE i.ItemName = s.Item
      );

    -- Step 3: Reload the fact rows for this year (avoids duplicates on rerun)
    DELETE FROM Sales.Fact_Sales
    WHERE YEAR(OrderDate) = @OrderYear;

    INSERT INTO Sales.Fact_Sales
        (CustomerID, ItemID, SalesOrderNumber,
         SalesOrderLineNumber, OrderDate, Quantity,
         TaxAmount, UnitPrice, [Year], [Month])
    SELECT
        s.CustomerName,
        s.Item,
        s.SalesOrderNumber,
        CAST(s.SalesOrderLineNumber AS INT),
        CAST(s.OrderDate AS DATE),
        CAST(s.Quantity AS INT),
        CAST(s.TaxAmount AS FLOAT),
        CAST(s.UnitPrice AS FLOAT),
        YEAR(CAST(s.OrderDate AS DATE)),
        MONTH(CAST(s.OrderDate AS DATE))
    FROM salesdata s
    WHERE YEAR(s.OrderDate) = @OrderYear
      AND s.CustomerName IS NOT NULL
      AND LTRIM(RTRIM(s.CustomerName)) <> ''
      AND s.Item IS NOT NULL
      AND s.SalesOrderNumber IS NOT NULL;

END
